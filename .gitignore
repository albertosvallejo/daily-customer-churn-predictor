# Python
__pycache__/
**/__pycache__/
*.py[cod]
*.so
.venv/
venv/
.env
.ipynb_checkpoints/

# Data artifacts
/data/interim/
/models/

# Raw data — source database never versioned
# Public source: https://www.kaggle.com/datasets/terencicp/e-commerce-dataset-by-olist-as-an-sqlite-database
data/raw/*.sqlite

# Internal / operational files
/_private/

# n8n drafts — only named canonical workflow files are versioned
n8n/*.jsonl

# Legacy notebook artifacts not intended for v1 public publication
notebooks/*.executed.ipynb
notebooks/*.audit_run.ipynb
notebooks/borrador notebook 01.txt

# Historical report archive kept locally / privately only
reports/archive/

# OS / editors
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Logs / runtime artifacts
logs/
*.log
*.pid

# Local runtime
*.sqlite-shm
*.sqlite-wal
